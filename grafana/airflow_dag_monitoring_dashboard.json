{
  "__inputs": [
    {
      "name": "DS_ZABBIX",
      "label": "Zabbix",
      "description": "Zabbix data source (alexanderzobnin-zabbix-datasource)",
      "type": "datasource",
      "pluginId": "alexanderzobnin-zabbix-datasource",
      "pluginName": "Zabbix"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "alexanderzobnin-zabbix-datasource", "name": "Zabbix", "version": "4.4.0" }
  ],
  "title": "Apache Airflow — DAG Monitoring (Zabbix)",
  "uid": "airflow-zabbix-dags",
  "tags": ["airflow", "zabbix", "dags"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Airflow host",
        "type": "query",
        "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${DS_ZABBIX}" },
        "query": { "queryType": "host", "group": "/.*/", "host": "/.*/" },
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Scheduler",
      "id": 1,
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${DS_ZABBIX}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "text",
          "textFilter": "",
          "group": { "filter": "/.*/" },
          "host": { "filter": "$host" },
          "application": { "filter": "" },
          "item": { "filter": "Airflow: Scheduler status" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "healthy": { "color": "green", "index": 0 } } },
            { "type": "value", "options": { "unhealthy": { "color": "red", "index": 1 } } },
            { "type": "value", "options": { "unknown": { "color": "orange", "index": 2 } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "Metadatabase",
      "id": 2,
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${DS_ZABBIX}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "text",
          "textFilter": "",
          "group": { "filter": "/.*/" },
          "host": { "filter": "$host" },
          "application": { "filter": "" },
          "item": { "filter": "Airflow: Metadatabase status" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "healthy": { "color": "green", "index": 0 } } },
            { "type": "value", "options": { "unhealthy": { "color": "red", "index": 1 } } },
            { "type": "value", "options": { "unknown": { "color": "orange", "index": 2 } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "Airflow version",
      "id": 3,
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${DS_ZABBIX}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "text",
          "textFilter": "",
          "group": { "filter": "/.*/" },
          "host": { "filter": "$host" },
          "application": { "filter": "" },
          "item": { "filter": "Airflow: Version" }
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "alexanderzobnin-zabbix-triggers-panel",
      "title": "Active Airflow problems",
      "id": 4,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${DS_ZABBIX}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "problems",
          "showProblems": "problems",
          "group": { "filter": "/.*/" },
          "host": { "filter": "$host" },
          "application": { "filter": "" },
          "proxy": { "filter": "" },
          "trigger": { "filter": "/Airflow.*/" },
          "tags": { "filter": "" }
        }
      ],
      "options": { "ackField": true, "ageField": true, "severityField": true, "statusField": true }
    },
    {
      "type": "table",
      "title": "DAGs — last run state",
      "id": 5,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${DS_ZABBIX}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "text",
          "textFilter": "",
          "group": { "filter": "/.*/" },
          "host": { "filter": "$host" },
          "application": { "filter": "" },
          "item": { "filter": "/Last DAG run state/" },
          "options": { "showDisabledItems": false, "skipEmptyValues": false }
        }
      ],
      "transformations": [
        { "id": "reduce", "options": { "reducers": ["lastNotNull"] } }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "success": { "color": "green", "index": 0 } } },
            { "type": "value", "options": { "failed": { "color": "red", "index": 1 } } },
            { "type": "value", "options": { "running": { "color": "blue", "index": 2 } } },
            { "type": "value", "options": { "queued": { "color": "orange", "index": 3 } } }
          ],
          "custom": { "cellOptions": { "type": "color-background" } }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "DAGs — last task instance state",
      "id": 6,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${DS_ZABBIX}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "text",
          "textFilter": "",
          "group": { "filter": "/.*/" },
          "host": { "filter": "$host" },
          "application": { "filter": "" },
          "item": { "filter": "/Last task instance state/" },
          "options": { "showDisabledItems": false, "skipEmptyValues": false }
        }
      ],
      "transformations": [
        { "id": "reduce", "options": { "reducers": ["lastNotNull"] } }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "success": { "color": "green", "index": 0 } } },
            { "type": "value", "options": { "failed": { "color": "red", "index": 1 } } },
            { "type": "value", "options": { "running": { "color": "blue", "index": 2 } } },
            { "type": "value", "options": { "up_for_retry": { "color": "orange", "index": 3 } } }
          ],
          "custom": { "cellOptions": { "type": "color-background" } }
        },
        "overrides": []
      }
    }
  ]
}
